WEATHERLINK_API_KEY=
WEATHERLINK_API_SECRET=
WEATHERLINK_STATION_ID=
WEATHERLINK_BASE_URL=https://api.weatherlink.com/v2

DATABASE_PATH=./data/weather.db

PORT=1456
NODE_ENV=development
LOG_LEVEL=info
APP_TIMEZONE=Europe/Dublin

CURRENT_POLL_INTERVAL_MS=60000
CURRENT_DELAYED_AFTER_SECONDS=300
CURRENT_STALE_AFTER_SECONDS=900

HISTORIC_SYNC_ENABLED=true
HISTORIC_INITIAL_START_DATE=
HISTORIC_MAX_CONCURRENCY=1

METRICS_ENABLED=true
DEFAULT_UNIT_SYSTEM=metric
DATA_RETENTION_RAW_DAYS=0
# 0 keeps data forever
RETENTION_OBSERVATION_MAX_AGE_DAYS=0
RETENTION_SUMMARY_MAX_AGE_DAYS=0
EXPORT_MAX_ROWS=1000000

# Uploads to the Outputs page (POST /api/v1/ingest/:kind). Leave empty to turn
# uploads off. Make one with: openssl rand -hex 24
INGEST_TOKEN=
# Name this machine shows as on the Outputs page (defaults to the hostname)
INGEST_SOURCE=
# Serve the built web app from the API (the container sets this)
WEB_DIST_DIR=
